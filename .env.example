# Folivora Environment Template
ENVIRONMENT=production
SENTRY_DSN=https://your_public_key@o0.ingest.sentry.io/0
ELEVENLABS_API_KEY=your_elevenlabs_api_key
GOOGLE_API_KEY=your_google_ai_studio_key
OPENROUTER_API_KEY=your_openrouter_gemma_key
TABPFN_TOKEN=your_priorlabs_tabpfn_token
BROWSERBASE_API_KEY=your_browserbase_api_key
BROWSERBASE_PROJECT_ID=your_browserbase_project_id
OLLAMA_BASE_URL=
GEMMA_TIMEOUT_S=8.0
# Gemini Flash Lite is the fast tab-polish lane (5-7s per card). Remote Gemma
# 3 27B needs 9-23s, so use SUMMARY_POLISH_PROVIDER=gemma only with local Ollama.
# Legacy aliases: SUMMARY_POLISH_MAX_TABS, SUMMARY_POLISH_BUDGET_S
RATE_LIMIT_ENABLED=1
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
